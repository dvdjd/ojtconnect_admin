generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output = "./node_modules/@prisma/client"
}



datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model application {
  application_id   String          @id
  job_id           String
  student_id       String
  message          String
  resume           String
  status           String          @default("pending") @db.VarChar(15)
  application_date DateTime        @default(now())
  interview_date   DateTime?
  meeting_link     String?
  is_accepted      Boolean         @default(false)
  m_id             String?         @db.VarChar(50)
  job_post         job_post        @relation(fields: [job_id], references: [job_id])
  student_profile  student_profile @relation(fields: [student_id], references: [student_id])
}

model bookmark {
  bookmark_id     String          @id
  job_id          String
  student_id      String
  bookmark_date   DateTime        @default(now())
  m_id            String?         @db.VarChar(50)
  job_post        job_post        @relation(fields: [job_id], references: [job_id])
  student_profile student_profile @relation(fields: [student_id], references: [student_id])
}

model company_profile {
  company_id     String      @id
  user_id        String      @unique
  name           String      @db.VarChar(100)
  company_type   String?     @db.VarChar(100)
  avatar         String?
  phone_number   String?
  business_proof String?
  about_me       String?
  fb_link        String?
  instagram_link String?
  linkedin_link  String?
  portfolio_link String?
  date_created   DateTime    @default(now())
  date_updated   DateTime    @default(now())
  country        String?     @db.VarChar(100)
  state          String?     @db.VarChar(100)
  m_id           String?     @db.VarChar(50)
  address_line   String?     @db.VarChar(128)
  user_access    user_access @relation(fields: [user_id], references: [user_id])
  job_post       job_post[]
}

model field_of_expertise {
  id    Int    @id @default(autoincrement())
  field String @db.VarChar(100)
}

model job_post {
  job_id          String          @id
  company_id      String
  position        String?         @db.VarChar(100)
  category        String?         @db.VarChar(40)
  work_setup      String?         @db.VarChar(20)
  description     String?
  duration        String?
  hours_per_week  String?
  status          String?         @db.VarChar(15)
  is_available    Boolean         @default(true)
  date_posted     DateTime?       @default(now())
  m_id            String?         @db.VarChar(50)
  application     application[]
  bookmark        bookmark[]
  company_profile company_profile @relation(fields: [company_id], references: [company_id])
}

model student_profile {
  student_id     String        @id
  user_id        String        @unique
  name           String        @db.VarChar(1000)
  university     String?       @db.VarChar(1000)
  course         String?       @db.VarChar(1000)
  level          String?       @db.VarChar(50)
  avatar         String?
  phone_number   String?
  skills         String?
  certificate    String?
  organization   String?
  about_me       String?
  instagram_link String?
  linkedin_link  String?
  portfolio_link String?
  date_created   DateTime?     @default(now())
  date_updated   DateTime?     @default(now())
  m_id           String?       @db.VarChar(50)
  fb_link        String?
  application    application[]
  bookmark       bookmark[]
  user_access    user_access   @relation(fields: [user_id], references: [user_id])
}

model university {
  university_id   String  @id
  university_name String  @db.VarChar(100)
  university_type String  @db.VarChar(50)
  address_line    String? @db.VarChar(255)
  state           String? @db.VarChar(50)
  country         String? @db.VarChar(50)
}

model university_admin {
  admin_id      String   @id
  user_id       String   @db.VarChar(15)
  university_id String   @db.VarChar(15)
  email         String   @unique @db.VarChar(100)
  password      String   @db.VarChar(100)
  admin_name    String   @db.VarChar(100)
  position      String   @db.VarChar(50)
  date_created  DateTime @default(now())
}

model university_profile {
  university_id   String      @id
  user_id         String      @unique
  position        String      @db.VarChar(100)
  avatar          String?
  phone_number    String?
  business_proof  String?
  about_me        String?
  fb_link         String?
  instagram_link  String?
  linkedin_link   String?
  portfolio_link  String?
  date_created    DateTime    @default(now())
  date_updated    DateTime    @default(now())
  address_line    String      @db.VarChar(100)
  state           String      @db.VarChar(50)
  admin_name      String      @db.VarChar(100)
  department      String      @db.VarChar(100)
  university_name String      @db.VarChar(100)
  university_type String      @db.VarChar(100)
  country         String      @db.VarChar(50)
  user_access     user_access @relation(fields: [user_id], references: [user_id])
}

model user_access {
  user_id            String              @id
  email              String              @unique @db.VarChar(100)
  password           String              @db.VarChar(100)
  type               String              @db.VarChar(15)
  is_verify          Boolean             @default(false)
  date_created       DateTime            @default(now())
  last_login         DateTime?           @default(now())
  m_id               String?             @db.VarChar(50)
  company_profile    company_profile?
  student_profile    student_profile?
  university_profile university_profile?
  user_logs          user_logs[]
}

model user_admin {
  id         Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(50)
  password   String   @db.VarChar(50)
  created_at DateTime @default(now())
}

model user_logs {
  email       String      @db.VarChar(100)
  type        String      @db.VarChar(15)
  login_date  DateTime    @default(now())
  log_id      String      @id
  m_id        String?     @db.VarChar(50)
  user_access user_access @relation(fields: [email], references: [email])
}
